#!/bin/bash
# Superseded by spike-model-engines' llama.cpp guide:
# https://github.com/JaimeStill/spike-model-engines/tree/main/docs/engines/llama.cpp
#
# Shows llama-router's systemd status and a quick /health check. No sudo
# needed — systemctl status is readable without it.
set -euo pipefail

systemctl status llama-router --no-pager
echo

# The router binds the tailnet interface specifically, not 0.0.0.0 or
# 127.0.0.1 (see setup/hosting-setup.md) — 127.0.0.1 never answers.
echo -n "health: "
curl -s "http://$(tailscale ip -4):8080/health"
echo
