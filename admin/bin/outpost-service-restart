#!/bin/bash
# Restarts the llama-router service and shows its status. Whether this is
# actually necessary after editing a profile (versus just unloading/reloading
# the affected model through /llama) hasn't been confirmed — use this when in
# doubt, or after changing [*] defaults that apply to already-loaded models.
set -euo pipefail

sudo systemctl restart llama-router

# `systemctl restart` returns as soon as the process forks — without a brief
# pause, the status below can catch the ExecStart wrapper (bash) before it
# execs into llama-server, showing a misleading Main PID.
sleep 1
sudo systemctl status llama-router --no-pager
