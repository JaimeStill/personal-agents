#!/bin/bash
# Dispatcher: routes `outpost <group> <verb> [args...]` to the script named
# `outpost-<group>-<verb>` in this same directory, passing the remaining args
# through. Add a new command by adding a new outpost-<group>-<verb> script
# here — nothing to register.
set -euo pipefail

self="$(readlink -f -- "${BASH_SOURCE[0]}")"
bin_dir="$(cd -- "$(dirname -- "$self")" && pwd)"

if [ "$#" -lt 2 ]; then
  echo "usage: outpost <group> <verb> [args...]" >&2
  echo "available:" >&2
  for script in "$bin_dir"/outpost-*; do
    name="${script##*/}"
    echo "  outpost ${name#outpost-} " | tr - ' ' >&2
  done
  exit 1
fi

group="$1"
verb="$2"
shift 2

target="$bin_dir/outpost-$group-$verb"
if [ ! -x "$target" ]; then
  echo "outpost: no such command '$group $verb' (looked for $target)" >&2
  exit 1
fi

exec "$target" "$@"
